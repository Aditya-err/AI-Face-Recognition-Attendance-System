# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# ─── Environment ──────────────────────────────────────────────────────────────
.env
*.env

# ─── Database ─────────────────────────────────────────────────────────────────
data/faceattend.db
data/*.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Models (large binary files, re-downloadable via download_models.py) ────
models/*.caffemodel
models/*.pb
models/*.prototxt
models/*.onnx
models/*.bin

# ─── Privacy: no raw training face datasets should be committed ─────────────
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# Whitelist UI screenshots for portfolio/README and test fixtures
!Screenshots/
!Screenshots/*
!tests/assets/*.jpg

# ─── IDE / tooling / caches ───────────────────────────────────────────────────
.freebuff/
.vscode/
.idea/
*.swp
.pytest_cache/
.ruff_cache/

# ─── Internal study & preparation notes (keep local only) ─────────────────────
interview_guide.md
RESUME_PORTFOLIO.md
*interview*
*RESUME*
