# Copy this file to `.env` and adjust values if needed.
# Every variable is optional - the defaults shown here are used when unset.

# --- Server -------------------------------------------------------------
# FA_HOST=127.0.0.1        # bind address (0.0.0.0 exposes it to the LAN)
# FA_PORT=8000
# FA_DEBUG=0
# FA_SECRET_KEY=change-me

# --- Paths --------------------------------------------------------------
# FA_DATA_DIR=data         # runtime data (SQLite database lives here)
# FA_DB_PATH=data/faceattend.db
# FA_MODELS_DIR=models

# --- Camera -------------------------------------------------------------
# FA_CAMERA_BACKEND=auto   # auto | dshow | msmf | v4l2
# FA_AUTOSTART_CAMERA=1    # 0 = start the camera only when a feed is opened

# --- Models -------------------------------------------------------------
# FA_DETECTOR_MODEL=face_detection_yunet_2023mar.onnx
# FA_RECOGNIZER_MODEL=face_recognition_sface_2021dec.onnx
